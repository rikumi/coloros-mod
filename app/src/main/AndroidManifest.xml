<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 开关点击时的短触摸反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:directBootAware="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:description="@string/xposed_description"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
        tools:ignore="MissingApplicationIcon">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ColorOSMod">
            <!-- LSPosed 启动按钮按 MODULE_SETTINGS 类别解析模块设置入口,
                 独立于桌面 LAUNCHER 别名, 隐藏图标后仍可从 LSPosed 进入。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 桌面图标入口别名: 隐藏桌面图标 = 禁用此别名, LSPosed 仍可直接拉起 MainActivity -->
        <activity-alias
            android:name=".MainActivityLauncher"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 跨进程暴露模块设置给被 hook 的进程读取(Binder 通道, 绕开 SELinux 对 app_data_file 的限制)。
             directBootAware: 开机到首次解锁前(锁定态)SystemUI 就要读设置, 非 directBootAware 的
             进程在该阶段无法被拉起, 查询会失败 —— 设置改存 DE 存储后必须同时声明此属性。 -->
        <provider
            android:name=".SettingsProvider"
            android:authorities="com.rikumi.colorosmod.settings"
            android:directBootAware="true"
            android:exported="true" />
    </application>

    <!--
        新版(libxposed)模块不再用 xposedmodule / xposedminversion / xposedscope 等
        meta-data: 入口见 META-INF/xposed/java_init.list, 作用域见 META-INF/xposed/scope.list,
        配置见 META-INF/xposed/module.prop, 名称用 android:label, 描述用 android:description。
    -->
</manifest>
